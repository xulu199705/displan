[Unit]
Description=DisPlan Display Layout Planner
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/xulu/Service/displan
ExecStart=/usr/bin/python3 /home/xulu/Service/displan/deploy/server.py --directory /home/xulu/Service/displan/current --port 55432
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=default.target
